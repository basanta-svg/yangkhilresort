---
import { Image } from 'astro:assets';
import { photos, alt } from '../data/photos';
interface Props {
  photo: string;
  flip?: boolean;
  tone?: 'light' | 'white' | 'navy';
  id?: string;
}
const { photo, flip = false, tone = 'light', id } = Astro.props;
const bg = { light: 'bg-light', white: 'bg-white', navy: 'bg-dark text-white/85' }[tone];
---

<section id={id} class="grid scroll-mt-20 lg:grid-cols-2">
  <div class:list={['img-zoom reveal relative min-h-[320px] sm:min-h-[460px] lg:min-h-[640px]', flip && 'lg:order-2']}>
    <Image src={photos[photo]} alt={alt[photo]} width={1400} class="absolute inset-0 h-full w-full object-cover" />
  </div>
  <div class:list={['flex items-center px-6 py-14 sm:px-12 lg:px-20 lg:py-20', bg]}>
    <div class="reveal mx-auto w-full max-w-[520px]">
      <slot />
    </div>
  </div>
</section>
