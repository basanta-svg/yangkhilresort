---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { photos, alt } from '../data/photos';
import { rooms as allRooms } from '../data/rooms';

// Only three room photos exist, so keep the shared one out of the first three visible slides.
const order = ['premium-single', 'premium-twin', 'deluxe-double', 'deluxe-single'];
const rooms = order.map((s) => allRooms.find((r) => r.slug === s)!);
---

<section aria-label="Accommodation">
  <div class="container-x pt-[72px] md:pt-[110px]">
    <SectionHeading title="Accommodation" intro="Twenty-one rooms across five cottages, overlooking the landscapes of Trongsa." />
  </div>
  <!-- Edge-to-edge carousel -->
  <div class="relative">
    <div class="swiper rooms-swiper">
      <div class="swiper-wrapper">
        {
          rooms.map((r) => (
            <div class="swiper-slide">
              <a href={`/booking/?room=${r.slug}`} class="group relative block aspect-[4/5] overflow-hidden bg-dark">
                <Image
                  src={photos[r.photo]}
                  alt={alt[r.photo]}
                  width={1000}
                  height={1250}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.06]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 p-7 text-white md:p-10">
                  <h3 class="text-[28px] !text-white md:text-[34px]">{r.name}</h3>
                  <p class="mt-1 text-[14px] text-white/85">{r.guests} · {r.beds}</p>
                  <span class="btn-outline mt-5">Enquire</span>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
    <button class="rooms-prev absolute left-0 top-1/2 z-10 hidden h-[64px] w-[38px] -translate-y-1/2 items-center justify-center bg-primary text-white transition-colors hover:bg-primary-dark md:flex" aria-label="Previous room">
      <Icon name="chevron-left" size={22} />
    </button>
    <button class="rooms-next absolute right-0 top-1/2 z-10 hidden h-[64px] w-[38px] -translate-y-1/2 items-center justify-center bg-primary text-white transition-colors hover:bg-primary-dark md:flex" aria-label="Next room">
      <Icon name="chevron-right" size={22} />
    </button>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, A11y } from 'swiper/modules';
  import 'swiper/css';
  new Swiper('.rooms-swiper', {
    modules: [Navigation, A11y],
    slidesPerView: 1.1,
    spaceBetween: 4,
    rewind: true,
    navigation: { prevEl: '.rooms-prev', nextEl: '.rooms-next' },
    breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
  });
</script>
