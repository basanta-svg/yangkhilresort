---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import ViewBanner from '../components/ViewBanner.astro';
import Reviews from '../components/Reviews.astro';
import RoomsCarousel from '../components/RoomsCarousel.astro';
import Amenities from '../components/Amenities.astro';
import ExploreSlideshow from '../components/ExploreSlideshow.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import BookCta from '../components/BookCta.astro';
---

<!-- Order follows the website brief: hero, about, reviews, accommodation, amenities, explore Trongsa, Book Now, footer -->
<BaseLayout>
  <Hero />
  <Welcome />
  <ViewBanner />
  <Reviews />
  <RoomsCarousel />
  <Amenities />
  <ExploreSlideshow />
  <InstagramStrip />
  <BookCta />
</BaseLayout>
